# {{ ansible_managed }}
# Source: roles/ai/templates/docker-compose.yml.j2 — edits here will be lost.

networks:
  proxy-local:
    external: true
  ai:
    external: false

volumes:
  openclaw-plugin-runtime-deps:

services:
  # ── Ollama — local LLM inference ──────────────────────────────
  ollama:
    image: ollama/ollama:latest
    container_name: ollama
    restart: unless-stopped
    ports:
      - 11434:11434
    volumes:
      - ./ollama:/root/.ollama
    environment:
      OLLAMA_HOST: 0.0.0.0
    # Capped so inference doesn't starve other services (2/4 cores, 4/15 GB RAM).
    # This fits llama3.2:3b (~2 GB) but not llama3.1:8b (~5 GB).
    # GPU: GTX 950M has only 2 GB VRAM — not enough for any useful model.
    deploy:
      resources:
        limits:
          cpus: '2'
          memory: 4G
    networks:
      - proxy-local
      - ai


  # ── SearXNG — privacy-respecting metasearch (used by Hermes Agent) ────
  searxng:
    image: searxng/searxng:latest
    container_name: searxng
    restart: unless-stopped
    volumes:
      - ./searxng:/etc/searxng:rw
    environment:
      SEARXNG_BASE_URL: "https://searxng.denispng.com/"
      UWSGI_WORKERS: "2"
      UWSGI_THREADS: "4"
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
    logging:
      driver: json-file
      options:
        max-size: "1m"
        max-file: "1"
    networks:
      - proxy-local
      - ai


  # ── Open WebUI — chat frontend for Ollama (and other LLM providers) ────
  open-webui:
    image: ghcr.io/open-webui/open-webui:main
    container_name: open-webui
    restart: unless-stopped
    env_file:
      - /home/denispng/secrets/ai.env
    environment:
      OLLAMA_BASE_URL: "http://ollama:11434"
      WEBUI_URL: "https://chat.denispng.com"
      WEBUI_NAME: "Denispng AI"
      # Set to "false" via the Admin UI after creating the first account.
      # Disabling here before any user exists locks you out of admin signup.
      ENABLE_SIGNUP: "true"
      DEFAULT_USER_ROLE: "pending"
      ENABLE_RAG_WEB_SEARCH: "true"
      RAG_WEB_SEARCH_ENGINE: "searxng"
      SEARXNG_QUERY_URL: "http://searxng:8080/search?q=<query>&format=json"
      # Hermes Agent runs on host, exposed at host.docker.internal:8642 (OpenAI-compat).
      # OPENAI_API_BASE_URLS / OPENAI_API_KEYS come from ai.env so the key isn't in git.
      ENABLE_OPENAI_API: "true"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - ./open-webui:/app/backend/data
    depends_on:
      - ollama
      - searxng
    networks:
      - proxy-local
      - ai
