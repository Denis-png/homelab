# {{ ansible_managed }}
# Source: roles/ai/templates/docker-compose.yml.j2 — edits here will be lost.

networks:
  proxy-local:
    external: true
  ai:
    external: false

services:
  # ── SearXNG — privacy-respecting metasearch (used by Hermes Agent) ────
  searxng:
    image: "{{ ai_searxng_repo }}@{{ ai_searxng_digest }}"
    container_name: searxng
    restart: unless-stopped

    environment:
      SEARXNG_BASE_URL: "https://{{ ai_searxng_subdomain }}.{{ homelab_domain }}"
      UWSGI_WORKERS: "2"
      UWSGI_THREADS: "4"

    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID

    logging:
      driver: json-file
      options:
        max-size: "1m"
        max-file: "1"

    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

    volumes:
      - ./searxng:/etc/searxng:rw
    networks:
      - proxy-local
      - ai


  # ── Open WebUI — chat frontend for Ollama (and other LLM providers) ────
  open-webui:
    image: "{{ ai_openwebui_repo }}@{{ ai_openwebui_digest }}"
    container_name: open-webui
    restart: unless-stopped

    env_file:
      - /home/denispng/secrets/ai.env

    environment:
      OLLAMA_BASE_URL: "http://ollama:11434"
      WEBUI_URL: "https://{{ ai_openwebui_subdomain }}.{{ homelab_domain }}"
      WEBUI_NAME: "Denispng AI"

      # Set to "false" via the Admin UI after creating the first account.
      # Disabling here before any user exists locks you out of admin signup.
      ENABLE_SIGNUP: "true"
      DEFAULT_USER_ROLE: "pending"
      ENABLE_RAG_WEB_SEARCH: "true"
      RAG_WEB_SEARCH_ENGINE: "searxng"
      SEARXNG_QUERY_URL: "http://searxng:8080/search?q=<query>&format=json"

      # Hermes Agent runs on host, exposed at host.docker.internal:8642 (OpenAI-compat).
      # OPENAI_API_BASE_URLS / OPENAI_API_KEYS come from ai.env so the key isn't in git.
      ENABLE_OPENAI_API: "true"

    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

    deploy:
      resources:
        limits:
          cpus: "{{ ai_openwebui_cpu_limit }}"
          memory: "{{ ai_openwebui_memory_limit }}"

    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - ./open-webui:/app/backend/data
    depends_on:
      - searxng
    networks:
      - proxy-local
      - ai
