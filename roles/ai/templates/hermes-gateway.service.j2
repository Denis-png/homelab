[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart={{ ai_hermes_home }}/hermes-agent/venv/bin/python -m hermes_cli.main gateway run --replace
WorkingDirectory={{ ai_hermes_home }}/hermes-agent
Environment="PATH={{ ai_hermes_home }}/hermes-agent/venv/bin:{{ ai_hermes_home }}/hermes-agent/node_modules/.bin:/usr/bin:{{ homelab_user_home }}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV={{ ai_hermes_home }}/hermes-agent/venv"
Environment="HERMES_HOME={{ ai_hermes_home }}"
Restart=always
RestartSec=60
RestartMaxDelaySec=300
RestartSteps=5
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
TimeoutStopSec=210
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
